    "jovyan@e6db64941a67:~$ cat /usr/local/bin/voila.start.sh\n",
    "#!/bin/bash\n",
    "mkdir -p ~/voila\n",
    "voila --Voila.ip=0.0.0.0 --port=$VOILA_PORT --no-browser --classic-tree \\\n",
    "    --VoilaConfiguration.file_allowlist=\"['.*']\" \\\n",
    "    ~/voila > /dev/null 2>&1 &"
   ]
